# Copiar como .env en la Pi (chmod 600). Nunca al repo.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
MONGO_URL=
MONGO_DB_NAME=his_consulta_externa
# Correo de produccion (Spacemail). En desarrollo: Mailpit 192.168.1.40:1025 sin TLS ni login.
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=contacto@devrojas.xyz
MAIL_PASS=
MAIL_FROM="IPS <contacto@devrojas.xyz>"
# Token del tunel de Cloudflare (Zero Trust > Networks > Tunnels). Solo con --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# Origen publico de la web (Funnel, 443). La API queda en :8443. Con Cloudflare: https://ips.<dominio>.
CORS_ORIGIN=https://servidor.tailf41173.ts.net
CLERK_AUTHORIZED_PARTIES=https://servidor.tailf41173.ts.net
