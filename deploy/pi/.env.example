# Solo referencia de las variables. En produccion NO se edita: up.sh genera el .env desde OpenBao (projects/b2b/prod). Nunca al repo.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
MONGO_URL=
MONGO_DB_NAME=his_consulta_externa
# Correo de produccion (Spacemail). En desarrollo: Mailpit 192.168.1.40:1025 sin TLS ni login.
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=contacto@devrojas.xyz
MAIL_PASS=
MAIL_FROM="IPS <contacto@devrojas.xyz>"
# Origen publico de la web (tunel de Cloudflare).
CORS_ORIGIN=https://ips.devrojas.xyz
CLERK_AUTHORIZED_PARTIES=https://ips.devrojas.xyz
