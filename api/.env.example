PORT=3001
# Origin of the Next.js frontend allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Local Postgres from docker-compose.yml (source of truth: writes + trace events)
DATABASE_URL=postgres://b2b:b2b@localhost:5433/b2b

# MongoDB read model for the patient timeline (any local Mongo, e.g. on 27017).
# Leave MONGO_URL empty to run without Mongo (timeline is then read from Postgres).
MONGO_URL=mongodb://localhost:27017/his
# Engine that answers GET .../timeline: mongo | postgres
TIMELINE_STORE=mongo
# How often (ms) trace events are copied from Postgres to Mongo
RELAY_INTERVAL_MS=500

# Hexclave: same project as the frontend (https://app.hexclave.com)
HEXCLAVE_API_URL=https://api.hexclave.com
HEXCLAVE_PROJECT_ID=
HEXCLAVE_PUBLISHABLE_CLIENT_KEY=
HEXCLAVE_SECRET_SERVER_KEY=
